PORT=3070
CORS_ORIGINS=http://localhost:5174,https://scoler.com.ar,https://www.scoler.com.ar

# Email Scoler

# Pegar acá el Signing Secret de Resend (suele empezar con whsec_)
SCOLER_RESEND_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: tolerancia en segundos para validar el timestamp del webhook
SCOLER_RESEND_WEBHOOK_TOLERANCE_SECONDS=300

RESEND_API_KEY_SCOLER=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SCOLER_CONTACT_FROM_EMAIL=contacto@scoler.com.ar
SCOLER_CONTACT_TO_EMAIL=diegompaz@gmail.com
SCOLER_APP_NAME=Scoler Servicios
# Opcional: si querés un destino distinto para mails entrantes, usá esta variable.
SCOLER_INCOMING_TO_EMAILS=

# Email Astre

RESEND_API_KEY_ASTRE=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASTRE_FROM_EMAIL=no-reply@astre.net.ar
ASTRE_APP_NAME=Astre
